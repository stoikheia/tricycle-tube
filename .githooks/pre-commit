#!/bin/sh
# Keep third-party game data out of the repository: no ROM/save images, no large binaries,
# and raster images only under logo/ and samples/.
status=0
for f in $(git diff --cached --name-only --diff-filter=AM); do
  case "$f" in
    *.nes|*.fds|*.unf|*.unif|*.sav|*.srm|*.state|*.st[0-9]) echo "pre-commit: refusing ROM/save file: $f"; status=1 ;;
  esac
  case "$f" in
    *.png|*.gif|*.jpg|*.jpeg|*.webp|*.apng)
      case "$f" in logo/*|samples/*) ;; *) echo "pre-commit: raster image outside logo/ or samples/: $f"; status=1 ;; esac ;;
  esac
  if [ -f "$f" ]; then
    size=$(wc -c < "$f")
    if [ "$size" -gt 5000000 ]; then echo "pre-commit: file larger than 5 MB: $f"; status=1; fi
    if head -c 4 "$f" | grep -q "NES" 2>/dev/null && [ "$(head -c 4 "$f" | od -An -c | tr -d ' ')" = "NES\\032" ]; then echo "pre-commit: iNES header found in $f"; status=1; fi
  fi
done
exit $status
